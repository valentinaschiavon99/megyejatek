rules_version = '2';

// Megyejáték: players can read profiles and the leaderboard when signed in, create their own
// profile once, and add their own scores. Nothing can be edited or deleted from the app.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isInt(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    function validUsername(u) {
      return u is string && u.matches('^[A-Za-z][A-Za-z0-9_.-]{2,19}$');
    }

    match /users/{uid} {
      allow read: if signedIn();

      // Created once at sign-up. The username must be the one the account was created with:
      // the auth e-mail is "<username lower-case>@users.megyejatek.invalid".
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'createdAt'])
        && validUsername(request.resource.data.username)
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.auth.token.email == request.resource.data.usernameLower + '@users.megyejatek.invalid'
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /scores/{scoreId} {
      allow read: if signedIn();

      // Plausibility limits mirror ScoringConfig.Default in the app:
      // at most 100 points × 5 multiplier per correct answer, plus at most
      // 6 s × 5 points of time bonus per question. Keep them in sync when scoring changes.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['uid', 'username', 'mode', 'score', 'timeMs', 'correct', 'total', 'hints', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username ==
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
        && request.resource.data.mode in ['megyek', 'szekhelyek', 'szomszedok', 'varosok', 'felsorolas']
        && isInt(request.resource.data.total, 1, 200)
        && isInt(request.resource.data.correct, 0, request.resource.data.total)
        && isInt(request.resource.data.hints, 0, 1000)
        // Nobody answers faster than half a second per question.
        && isInt(request.resource.data.timeMs, request.resource.data.total * 500, 86400000)
        && isInt(request.resource.data.score, 0,
             request.resource.data.correct * 500 + request.resource.data.total * 30)
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
