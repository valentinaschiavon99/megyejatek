<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system CAs only: no user-installed CAs, so a proxy certificate on the
     phone cannot read the app's traffic (relevant once accounts and leaderboards go online). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
